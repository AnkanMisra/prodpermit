{
  "name": "recovery-control-room",
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": "24.x"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"bun run dev:api\" \"bun run dev:web\"",
    "dev:api": "cargo run -p recovery-api",
    "dev:web": "bun run --cwd apps/web dev",
    "typecheck": "bun run --cwd apps/web typecheck",
    "lint": "bun run --cwd apps/web lint",
    "test:web": "bun run --cwd apps/web test",
    "build:web": "bun run --cwd apps/web build",
    "test:e2e": "bun run --cwd apps/web test:e2e",
    "build:containers": "docker compose build",
    "deploy:backend:check": "docker compose --env-file .env.backend -f deploy/backend.compose.yml config --quiet",
    "deploy:backend": "./scripts/deploy-backend.sh",
    "deploy:ingress": "./scripts/deploy-cloudflare-ingress.sh"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
